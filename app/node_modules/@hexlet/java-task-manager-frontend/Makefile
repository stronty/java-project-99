start:
	npm run dev

install:
	npm i

build:
	npm run build

lint:
	npm run lint

# Публикация пакета — локальная, из этого каталога, с npm-токеном в ~/.npmrc.
# CI пакет не публикует: джоба frontend_deploy удалена вместе с переходом на
# release-it (она стояла на `only: [tags]` и ни разу не срабатывала).
#
# release        — обычный путь: release-it поднимает версию, коммитит, ставит тег,
#                  пушит и публикует в npm.
# release-current — выпустить версию, которая уже стоит в package.json, не поднимая
#                  её (release-it умеет только повышать). Нужно, когда версию
#                  подняли руками в отдельном коммите — как сейчас с 1.0.26.
#
# Перед публикацией release-it сам прогоняет lint и сборку (хук before:init в
# .release-it.json): в пакет уезжает и src, и dist, так что несобираемый фронтенд
# уехал бы к студентам молча.
release:
	npx release-it

release-current:
	npx release-it --no-increment
